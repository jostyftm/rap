#!/usr/bin/env bash

# RPA Studio - Local Development Environment Manager
# Usage: ./dev [init|start|stop|restart|status|logs|artisan|bash]

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_DIR="$PROJECT_ROOT/.dev/pids"
LOG_DIR="$PROJECT_ROOT/.dev/logs"

mkdir -p "$PID_DIR" "$LOG_DIR"

# Colors
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_GREEN='\033[32m'
C_RED='\033[31m'
C_YELLOW='\033[33m'
C_CYAN='\033[36m'
C_BLUE='\033[34m'
C_MAGENTA='\033[35m'

print_header() {
    echo -e "${C_CYAN}${C_BOLD}"
    echo "=========================================================="
    echo "       RPA Studio - Entorno de Desarrollo Local           "
    echo "=========================================================="
    echo -e "${C_RESET}"
}

is_port_listening() {
    local port=$1
    if command -v nc >/dev/null 2>&1; then
        nc -z localhost "$port" 2>/dev/null
    elif command -v ss >/dev/null 2>&1; then
        ss -tuln | grep -q ":$port "
    else
        (echo > /dev/tcp/localhost/"$port") >/dev/null 2>&1
    fi
}

is_pid_running() {
    local pid=$1
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

get_env_value() {
    local key=$1
    local default_val=${2:-}
    local env_file="$PROJECT_ROOT/.env"
    local val=""

    if [ -f "$env_file" ]; then
        val=$(grep -E "^${key}=" "$env_file" | tail -n1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d ' \r')
    fi

    echo "${val:-$default_val}"
}

get_web_port() {
    get_env_value "WEB_PORT" "3090"
}

export_runner_env() {
    export NODE_OPTIONS="--max-http-header-size=262144 ${NODE_OPTIONS:-}"
    local env_file="$PROJECT_ROOT/.env"
    local value port redis_port

    if [ -f "$env_file" ]; then
        value=$(get_env_value "RPA_INTERNAL_SECRET")
        if [ -n "$value" ]; then
            export RPA_INTERNAL_SECRET="$value"
        fi

        port=$(get_env_value "APP_PORT" "8000")
        export APP_PORT="$port"

        value=$(get_env_value "RPA_INTERNAL_URL")
        if [ -z "$value" ]; then
            value="http://127.0.0.1:${port}"
        fi
        export RPA_INTERNAL_URL="$value"

        # El Runner corre en el host, por eso usa FORWARD_REDIS_PORT (puerto mapeado al host)
        redis_port=$(get_env_value "FORWARD_REDIS_PORT")
        if [ -z "$redis_port" ]; then
            redis_port=$(get_env_value "REDIS_PORT" "6379")
        fi
        export REDIS_PORT="$redis_port"

        local key
        for key in REDIS_PASSWORD S3_ENDPOINT S3_ACCESS_KEY S3_SECRET_KEY S3_BUCKET S3_PUBLIC_URL RUNNER_LIVE_PORT RUNNER_LIVE_TOKEN RUNNER_HEADLESS RPA_HTTP_HOST_ALIASES; do
            value=$(get_env_value "$key")
            if [ -n "$value" ]; then
                export "${key}=${value}"
            fi
        done
    fi
}

export_web_env() {
    local env_file="$PROJECT_ROOT/.env"
    local web_port value
    web_port=$(get_web_port)
    export WEB_PORT="$web_port"

    if [ -f "$env_file" ]; then
        local key
        for key in NEXT_PUBLIC_API_URL NEXT_PUBLIC_REVERB_APP_KEY NEXT_PUBLIC_REVERB_HOST NEXT_PUBLIC_REVERB_PORT NEXT_PUBLIC_REVERB_SCHEME NEXT_PUBLIC_S3_URL NEXT_PUBLIC_LIVE_PORT; do
            value=$(get_env_value "$key")
            if [ -n "$value" ]; then
                export "${key}=${value}"
            fi
        done
    fi
}

start_background_service() {
    local name=$1
    local cmd=$2
    local pid_file="$PID_DIR/$name.pid"
    local log_file="$LOG_DIR/$name.log"

    if [ -f "$pid_file" ]; then
        local existing_pid=$(cat "$pid_file")
        if is_pid_running "$existing_pid"; then
            echo -e "  ${C_YELLOW}⚠ $name ya se encuentra en ejecución (PID: $existing_pid)${C_RESET}"
            return 0
        fi
    fi

    echo -ne "  ${C_BLUE}→ Iniciando $name...${C_RESET}"
    cd "$PROJECT_ROOT"
    setsid bash -c "$cmd" < /dev/null > "$log_file" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$pid_file"
    sleep 2

    if is_pid_running "$new_pid"; then
        echo -e "\r  ${C_GREEN}✓ $name iniciado (PID: $new_pid)${C_RESET}"
    else
        echo -e "\r  ${C_RED}✗ Error iniciando $name. Ver log en: $log_file${C_RESET}"
    fi
}

stop_process_by_pid() {
    local name=$1
    local pid_file="$PID_DIR/$name.pid"

    if [ -f "$pid_file" ]; then
        local pid=$(cat "$pid_file")
        if is_pid_running "$pid"; then
            echo -ne "  ${C_YELLOW}→ Deteniendo $name (PID: $pid)...${C_RESET}"
            kill -- "-$pid" 2>/dev/null || pkill -P "$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
            local count=0
            while is_pid_running "$pid" && [ $count -lt 5 ]; do
                sleep 0.5
                count=$((count + 1))
            done
            if is_pid_running "$pid"; then
                kill -9 -- "-$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
            fi
            echo -e "\r  ${C_GREEN}✓ $name detenido.${C_RESET}                   "
        fi
        rm -f "$pid_file"
    fi
}

cmd_init() {
    print_header
    local force=0
    if [ "${1:-}" = "--force" ]; then
        force=1
    fi

    local target="$PROJECT_ROOT/.env"
    local template="$PROJECT_ROOT/.env.dev.example"
    if [ ! -f "$template" ]; then
        template="$PROJECT_ROOT/.env.example"
    fi

    if [ ! -f "$template" ]; then
        echo -e "${C_RED}✗ No se encontró plantilla (.env.dev.example o .env.example).${C_RESET}"
        exit 1
    fi

    if [ -f "$target" ] && [ "$force" -ne 1 ]; then
        echo -e "${C_YELLOW}⚠ Ya existe $target. Usa './dev init --force' si deseas sobrescribirlo.${C_RESET}"
        return 0
    fi

    cp "$template" "$target"
    echo -e "${C_GREEN}✓ Archivo .env de desarrollo creado desde $(basename "$template").${C_RESET}"
}

cmd_start() {
    print_header
    echo -e "${C_BOLD}1. Levantando infraestructura con Docker Sail...${C_RESET}"
    cd "$PROJECT_ROOT"
    docker compose up -d

    echo -ne "\n${C_BLUE}Esperando disponibilidad de PostgreSQL y Redis...${C_RESET}"
    local retries=30
    local ready=0
    while [ $retries -gt 0 ]; do
        if docker compose exec -u sail laravel.test php artisan db:show >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 1
        retries=$((retries - 1))
        echo -ne "."
    done
    echo ""

    if [ $ready -eq 1 ]; then
        echo -e "${C_GREEN}✓ Infraestructura y base de datos listas.${C_RESET}"
    else
        echo -e "${C_YELLOW}⚠ Base de datos tardando en responder. Continuando con las migraciones...${C_RESET}"
    fi

    echo -e "\n${C_BOLD}2. Ejecutando migraciones de Laravel...${C_RESET}"
    docker compose exec -u sail laravel.test php artisan migrate --force || true

    echo -e "\n${C_BOLD}3. Compilando paquetes compartidos (@rpa/dsl, @rpa/locator)...${C_RESET}"
    pnpm --filter @rpa/dsl build
    pnpm --filter @rpa/locator build

    echo -e "\n${C_BOLD}4. Verificando navegadores de Playwright...${C_RESET}"
    if [ ! -d "$HOME/.cache/ms-playwright" ] || [ -z "$(ls -A "$HOME/.cache/ms-playwright" 2>/dev/null)" ]; then
        echo -e "  ${C_YELLOW}→ Descargando navegadores necesarios de Playwright...${C_RESET}"
        pnpm --filter @rpa/runner exec playwright install chromium || true
    else
        echo -e "  ${C_GREEN}✓ Navegadores de Playwright listos.${C_RESET}"
    fi

    echo -e "\n${C_BOLD}5. Iniciando servicios de desarrollo local (Host)...${C_RESET}"
    export_runner_env
    export_web_env
    start_background_service "testsite" "env PORT=8099 node testsite/server.js"
    start_background_service "runner" "NODE_OPTIONS='--max-http-header-size=262144' pnpm --filter @rpa/runner dev"
    start_background_service "web" "WEB_PORT=${WEB_PORT} pnpm --filter web dev"

    sleep 2
    cmd_status
}

cmd_stop() {
    print_header
    echo -e "${C_BOLD}Deteniendo servicios en el Host...${C_RESET}"
    stop_process_by_pid "web"
    stop_process_by_pid "runner"
    stop_process_by_pid "testsite"

    # Limpieza de posibles procesos residuales en puertos clave
    local web_port
    web_port=$(get_web_port)
    for p in "$web_port" 8099; do
        if command -v fuser >/dev/null 2>&1; then
            fuser -k -n tcp "$p" 2>/dev/null || true
        fi
    done

    echo -e "\n${C_BOLD}Deteniendo contenedores Docker Sail...${C_RESET}"
    cd "$PROJECT_ROOT"
    docker compose down --remove-orphans

    echo -e "\n${C_GREEN}✓ Todo el entorno ha sido detenido correctamente.${C_RESET}\n"
}

cmd_status() {
    echo -e "\n${C_BOLD}================ Estado de los Servicios =================${C_RESET}"
    printf "%-18s %-10s %-12s %-25s\n" "SERVICIO" "ESTADO" "PUERTO/PID" "URL / DETALLES"
    echo "----------------------------------------------------------"

    local app_port reverb_port db_port redis_port s3_port s3_console_port web_port live_port
    app_port=$(get_env_value "APP_PORT" "8000")
    reverb_port=$(get_env_value "REVERB_SERVER_PORT" "8080")
    db_port=$(get_env_value "FORWARD_DB_PORT" "5432")
    redis_port=$(get_env_value "FORWARD_REDIS_PORT" "6379")
    s3_port=$(get_env_value "FORWARD_STORAGE_PORT" "9000")
    s3_console_port=$(get_env_value "FORWARD_STORAGE_CONSOLE_PORT" "9001")
    web_port=$(get_web_port)
    live_port=$(get_env_value "RUNNER_LIVE_PORT" "8085")

    # Laravel API
    if is_port_listening "$app_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "Laravel API" "ONLINE" "$app_port" "http://localhost:$app_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "Laravel API" "OFFLINE" "$app_port" "http://localhost:$app_port"
    fi

    # Laravel Reverb
    if is_port_listening "$reverb_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "Reverb WS" "ONLINE" "$reverb_port" "ws://localhost:$reverb_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "Reverb WS" "OFFLINE" "$reverb_port" "ws://localhost:$reverb_port"
    fi

    # PostgreSQL
    if is_port_listening "$db_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "PostgreSQL" "ONLINE" "$db_port" "pgsql://rpa_user:***@$db_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "PostgreSQL" "OFFLINE" "$db_port" "pgsql://rpa_user:***@$db_port"
    fi

    # Redis
    if is_port_listening "$redis_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "Redis" "ONLINE" "$redis_port" "redis://localhost:$redis_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "Redis" "OFFLINE" "$redis_port" "redis://localhost:$redis_port"
    fi

    # RustFS (S3)
    if is_port_listening "$s3_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "RustFS S3" "ONLINE" "$s3_port/$s3_console_port" "Console: http://localhost:$s3_console_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "RustFS S3" "OFFLINE" "$s3_port/$s3_console_port" "http://localhost:$s3_port"
    fi

    # Web Next.js
    local web_pid=$(cat "$PID_DIR/web.pid" 2>/dev/null || echo "")
    if is_port_listening "$web_port" || is_pid_running "$web_pid"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "Next.js Web" "ONLINE" "$web_port" "http://localhost:$web_port"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "Next.js Web" "OFFLINE" "$web_port" "http://localhost:$web_port"
    fi

    # RPA Runner
    local runner_pid=$(cat "$PID_DIR/runner.pid" 2>/dev/null || echo "")
    if is_pid_running "$runner_pid"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "RPA Runner" "ONLINE" "PID $runner_pid" "tsx watch (Playwright)"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "RPA Runner" "OFFLINE" "-" "tsx watch"
    fi

    # Sitio en Vivo (proxy + control del Runner)
    if is_port_listening "$live_port"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "Live Proxy" "ONLINE" "$live_port" "http://localhost:$live_port/health"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "Live Proxy" "OFFLINE" "$live_port" "http://localhost:$live_port/health"
    fi

    # TestSite Mock
    local test_pid=$(cat "$PID_DIR/testsite.pid" 2>/dev/null || echo "")
    if is_port_listening 8099 || is_pid_running "$test_pid"; then
        printf "%-18s ${C_GREEN}%-10s${C_RESET} %-12s %-25s\n" "TestSite Mock" "ONLINE" "8099" "http://localhost:8099"
    else
        printf "%-18s ${C_RED}%-10s${C_RESET} %-12s %-25s\n" "TestSite Mock" "OFFLINE" "8099" "http://localhost:8099"
    fi

    echo "=========================================================="
    echo -e "${C_CYAN}Comandos útiles:${C_RESET}"
    echo "  ./dev logs [web|runner|testsite|api|reverb|storage|all] - Ver logs en vivo"
    echo "  ./dev artisan <comando>                                  - Ejecutar artisan en Sail"
    echo "  ./dev stop                                               - Detener todo el entorno"
    echo "==========================================================\n"
}

cmd_logs() {
    local target=$1
    case "$target" in
        web)
            tail -f "$LOG_DIR/web.log"
            ;;
        runner)
            tail -f "$LOG_DIR/runner.log"
            ;;
        testsite)
            tail -f "$LOG_DIR/testsite.log"
            ;;
        api)
            docker compose logs -f laravel.test
            ;;
        reverb)
            docker compose logs -f laravel.test
            ;;
        db|pgsql)
            docker compose logs -f pgsql
            ;;
        redis)
            docker compose logs -f redis
            ;;
        storage|rustfs|minio)
            docker compose logs -f rustfs
            ;;
        all|"")
            echo -e "${C_CYAN}Mostrando logs simultáneos de Host (web, runner, testsite). Presiona Ctrl+C para salir.${C_RESET}"
            tail -f "$LOG_DIR"/*.log
            ;;
        *)
            echo -e "${C_RED}Servicio desconocido: $target${C_RESET}"
            echo "Opciones disponibles: web, runner, testsite, api, reverb, db, redis, storage, all"
            exit 1
            ;;
    esac
}

cmd_artisan() {
    cd "$PROJECT_ROOT"
    docker compose exec -u sail laravel.test php artisan "$@"
}

cmd_bash() {
    cd "$PROJECT_ROOT"
    docker compose exec -u sail laravel.test bash
}

# Main routing
case "$1" in
    init)
        shift
        cmd_init "$@"
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_stop
        sleep 1
        cmd_start
        ;;
    status)
        cmd_status
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    artisan)
        shift
        cmd_artisan "$@"
        ;;
    bash)
        cmd_bash
        ;;
    *)
        echo "Uso: ./dev [init|start|stop|restart|status|logs|artisan|bash]"
        exit 1
        ;;
esac
