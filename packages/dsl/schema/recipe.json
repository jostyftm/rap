{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpa-studio.dev/schemas/recipe.v1.json",
  "title": "RPARecipe",
  "description": "Especificación formal del grafo dirigido de acciones de RPA Studio",
  "type": "object",
  "required": ["schema", "entry", "nodes", "edges"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rpa/v1"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "type": { "type": "string", "enum": ["string", "number", "boolean", "array", "object"] },
          "defaultValue": {},
          "description": { "type": "string" }
        }
      },
      "default": []
    },
    "secrets": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "entry": {
      "type": "string",
      "description": "ID del nodo inicial del grafo"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "LocatorCandidate": {
      "type": "object",
      "required": ["strategy", "value", "score"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["testid", "role", "label", "text", "css", "xpath", "vision"]
        },
        "value": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "SemanticFingerprint": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "accessibleName": { "type": "string" },
        "tag": { "type": "string" },
        "text": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "attributes": { "type": "object" },
        "boundingBox": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      }
    },
    "LocatorGroup": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/LocatorCandidate" },
        "fallbacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocatorCandidate" },
          "default": []
        },
        "fingerprint": { "$ref": "#/$defs/SemanticFingerprint" }
      }
    },
    "Node": {
      "type": "object",
      "required": ["id", "type", "description", "params"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "click",
            "type",
            "select",
            "waitFor",
            "extract",
            "screenshot",
            "setVariable",
            "javascript",
            "condition",
            "loop",
            "scroll",
            "webhook",
            "respond",
            "httpRequest",
            "tryCatch"
          ]
        },
        "description": { "type": "string" },
        "timeout": { "type": "number", "default": 30000 },
        "onError": {
          "type": "string",
          "enum": ["fail", "continue", "retry"],
          "default": "fail"
        },
        "retry": {
          "type": "object",
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
            "delayMs": { "type": "integer", "minimum": 0, "maximum": 60000, "default": 1000 },
            "backoff": {
              "type": "string",
              "enum": ["fixed", "exponential"],
              "default": "exponential"
            }
          }
        },
        "screenshot": {
          "type": "string",
          "enum": ["never", "onError", "always"],
          "default": "onError"
        },
        "preview": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "targetScope": { "type": "string", "enum": ["browser", "desktop"], "default": "browser" },
            "capturedAt": { "type": "number" },
            "windowTitle": { "type": "string" },
            "coordinates": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            },
            "elementSnippet": { "type": "string" }
          }
        },
        "locator": { "$ref": "#/$defs/LocatorGroup" },
        "params": { "type": "object" },
        "next": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "condition" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["expression", "thenNodeId"],
                "properties": {
                  "expression": { "type": "string", "minLength": 1 },
                  "thenNodeId": { "type": "string", "minLength": 1 },
                  "elseNodeId": { "type": "string" },
                  "dataType": {
                    "type": "string",
                    "enum": ["string", "number", "boolean", "array", "exists", "custom"]
                  },
                  "leftOperand": { "type": "string" },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "equals",
                      "not_equals",
                      "contains",
                      "not_contains",
                      "starts_with",
                      "ends_with",
                      "regex_match",
                      "greater_than",
                      "greater_than_or_equal",
                      "less_than",
                      "less_than_or_equal",
                      "is_true",
                      "is_false",
                      "array_contains",
                      "array_is_empty",
                      "array_not_empty",
                      "is_null",
                      "is_not_null",
                      "is_empty",
                      "is_not_empty",
                      "is_null_or_empty",
                      "is_not_null_or_empty"
                    ]
                  },
                  "rightOperand": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "tryCatch" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["tryEntryNodeId", "catchEntryNodeId"],
                "properties": {
                  "tryEntryNodeId": { "type": "string", "minLength": 1 },
                  "catchEntryNodeId": { "type": "string", "minLength": 1 },
                  "finallyEntryNodeId": { "type": "string" },
                  "errorVariable": { "type": "string", "minLength": 1, "default": "error" },
                  "rethrow": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "javascript" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "mode": {
                    "type": "string",
                    "enum": ["sandbox", "browser"],
                    "default": "sandbox"
                  },
                  "outputVariable": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "webhook" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "httpMethod": {
                    "type": "string",
                    "enum": ["ANY", "GET", "POST", "PUT", "DELETE", "PATCH"]
                  },
                  "path": { "type": "string" },
                  "outputVariable": { "type": "string" },
                  "responseCode": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "responseBody": { "type": "string" },
                  "responseMode": {
                    "type": "string",
                    "enum": ["immediate", "lastNode", "respondNode"]
                  },
                  "responseTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
                  "responseHeaders": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "respond" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["responseType"],
                "properties": {
                  "responseType": {
                    "type": "string",
                    "enum": ["json", "text", "html", "xml", "binary", "redirect", "empty"]
                  },
                  "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "body": { "type": "string" },
                  "redirectUrl": { "type": "string" },
                  "contentType": { "type": "string" },
                  "filename": { "type": "string" },
                  "headers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "terminateFlow": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "httpRequest" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["method", "url"],
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
                  },
                  "url": { "type": "string", "minLength": 1 },
                  "pathParams": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "queryParams": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "headers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "auth": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "type": "string", "enum": ["none", "bearer", "basic", "apiKey"] },
                      "token": { "type": "string" },
                      "username": { "type": "string" },
                      "password": { "type": "string" },
                      "keyName": { "type": "string" },
                      "keyValue": { "type": "string" },
                      "in": { "type": "string", "enum": ["header", "query"] }
                    }
                  },
                  "bodyType": {
                    "type": "string",
                    "enum": ["none", "json", "formUrlEncoded", "multipart", "raw", "binary"]
                  },
                  "bodyJson": { "type": "string" },
                  "bodyForm": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "bodyMultipart": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "fieldType": { "type": "string", "enum": ["text", "fileBase64"] },
                        "filename": { "type": "string" },
                        "contentType": { "type": "string" },
                        "enabled": { "type": "boolean" }
                      }
                    }
                  },
                  "bodyRaw": { "type": "string" },
                  "rawContentType": { "type": "string" },
                  "bodyBinaryBase64": { "type": "string" },
                  "binaryContentType": { "type": "string" },
                  "responseType": {
                    "type": "string",
                    "enum": ["auto", "json", "text", "xml", "binary", "headersOnly"]
                  },
                  "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 300000 },
                  "followRedirects": { "type": "boolean" },
                  "failOnHttpError": { "type": "boolean" },
                  "outputVariable": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
