# ==============================================================================
# RPA Studio - Plantilla de Configuración de Entorno de Producción (.env.prod.example)
# ==============================================================================
# NO uses referencias ${VAR} entre variables dentro de este archivo: Docker Compose
# env_file no las interpola. Ejecuta `./prod init` para generar `.env.prod` con
# secretos aleatorios seguros, o `./prod init --domain tu-dominio.com`.

# ==============================================================================
# 1. PROYECTO DOCKER Y DOMINIO PÚBLICO (CADDY)
# ==============================================================================
COMPOSE_PROJECT_NAME=rpa-prod
APP_DOMAIN=localhost
APP_SCHEME=http
CADDY_SITE_ADDRESS=:80
CADDY_HTTP_PORT=8050
CADDY_HTTPS_PORT=4443

# ==============================================================================
# 2. APLICACIÓN LARAVEL (apps/api)
# ==============================================================================
APP_NAME="RPA Studio"
APP_ENV=production
APP_KEY=__CHANGE_ME_APP_KEY__
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ==============================================================================
# 3. BASE DE DATOS RELACIONAL (POSTGRESQL 16)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rpa_studio
DB_USERNAME=rpa_user
DB_PASSWORD=__CHANGE_ME_DB_PASSWORD__

POSTGRES_DB=rpa_studio
POSTGRES_USER=rpa_user
POSTGRES_PASSWORD=__CHANGE_ME_DB_PASSWORD__

# ==============================================================================
# 4. CACHÉ, SESIONES, COLAS Y STREAMS (REDIS 7)
# ==============================================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME_REDIS_PASSWORD__

COMMAND_STREAM=rpa:cmd
EVENT_STREAM=rpa:evt

# ==============================================================================
# 5. WEBSOCKETS EN TIEMPO REAL (LARAVEL REVERB)
# ==============================================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rpa-studio
REVERB_APP_KEY=__CHANGE_ME_REVERB_APP_KEY__
REVERB_APP_SECRET=__CHANGE_ME_REVERB_APP_SECRET__
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ==============================================================================
# 6. AUTENTICACIÓN SANCTUM Y CORS
# ==============================================================================
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ==============================================================================
# 7. ALMACENAMIENTO DE OBJETOS COMPATIBLE CON S3 (RUSTFS)
# ==============================================================================
RUSTFS_ACCESS_KEY=__CHANGE_ME_S3_ACCESS_KEY__
RUSTFS_SECRET_KEY=__CHANGE_ME_S3_SECRET_KEY__
RUSTFS_CONSOLE_ENABLE=false
RUSTFS_VOLUMES=/data

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=__CHANGE_ME_S3_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__CHANGE_ME_S3_SECRET_KEY__
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rpa-artifacts
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=__CHANGE_ME_S3_ACCESS_KEY__
S3_SECRET_KEY=__CHANGE_ME_S3_SECRET_KEY__
S3_BUCKET=rpa-artifacts
S3_PUBLIC_URL=

# ==============================================================================
# 8. INTELIGENCIA ARTIFICIAL Y MODELOS (LLM)
# ==============================================================================
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
RPA_LLM_FAST_MODEL=gemini-2.5-flash
RPA_LLM_STRONG_MODEL=gemini-2.5-pro

# ==============================================================================
# 9. FRONTEND NEXT.JS (apps/web — se inyectan en build-time)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_REVERB_APP_KEY=__CHANGE_ME_REVERB_APP_KEY__
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=80
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_LIVE_HOST=
NEXT_PUBLIC_LIVE_PORT=80
NEXT_PUBLIC_S3_URL=

# ==============================================================================
# 10. SITIO EN VIVO Y RUNNER (apps/runner)
# ==============================================================================
RUNNER_HEADLESS=true
RUNNER_LIVE_PORT=8085
RUNNER_LIVE_URL=http://runner:8085
RUNNER_LIVE_TOKEN=__CHANGE_ME_RUNNER_LIVE_TOKEN__
RPA_HTTP_ALLOW_PRIVATE_NETWORKS=false

# ==============================================================================
# 11. API INTERNA RUNNER ⇄ LARAVEL Y KEYRING DE SECRETOS
# ==============================================================================
RPA_INTERNAL_SECRET=__CHANGE_ME_INTERNAL_SECRET__
RPA_INTERNAL_SIGNATURE_TTL=60
RPA_INTERNAL_URL=http://api:8000
RPA_SECRET_ACTIVE_KEY=v1
RPA_SECRET_KEYS={"v1":"__CHANGE_ME_32B_BASE64__"}
