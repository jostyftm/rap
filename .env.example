# ==========================================
# RPA Studio — Configuración de Entorno
# ==========================================

# Aplicación
APP_NAME="RPA Studio"
APP_ENV=local
APP_KEY=base64:9ZlZk4Xv9ZlZk4Xv9ZlZk4Xv9ZlZk4Xv9ZlZk4Xv9Zk=
APP_DEBUG=true
APP_URL=http://localhost

# Base de Datos (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rpa_studio
DB_USERNAME=rpa_user
DB_PASSWORD=secret_password

# Caché, Sesiones y Colas (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Laravel Reverb (WebSockets en tiempo real)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rpa-studio
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Almacenamiento de Artefactos (MinIO local / S3 en producción)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rpa-artifacts
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Modelos e IA (Google Gemini por defecto mediante laravel/ai)
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
RPA_LLM_FAST_MODEL=gemini-2.5-flash
RPA_LLM_STRONG_MODEL=gemini-2.5-pro

# Proveedores alternativos (opcionales)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# Límites duros de seguridad por sesión
RPA_SESSION_MAX_STEPS=40
RPA_SESSION_MAX_COST_USD=1.00
RPA_SESSION_MAX_SECONDS=900

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=80
NEXT_PUBLIC_REVERB_SCHEME=http
