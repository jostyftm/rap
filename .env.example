# ==============================================================================
# RPA Studio - Plantilla de Configuración de Entorno de Desarrollo (.env.example)
# ==============================================================================
# Alias alineado con .env.dev.example. Copia este archivo a .env o ejecuta: ./dev init

# ==============================================================================
# 1. DOCKER & LARAVEL SAIL
# ==============================================================================
COMPOSE_PROJECT_NAME=rpa-dev
WWWUSER=1000
WWWGROUP=1000
LARAVEL_SAIL=1
SUPERVISOR_PHP_USER=sail

APP_PORT=8000
REVERB_SERVER_PORT=8080
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_STORAGE_PORT=9000
FORWARD_STORAGE_CONSOLE_PORT=9001

# ==============================================================================
# 2. APLICACIÓN LARAVEL (apps/api)
# ==============================================================================
APP_NAME="RPA Studio"
APP_ENV=local
APP_KEY=base64:kqx2C0B3a2aRRew2cQ2wNc7TM2urcXEtkVdNBdQEU8w=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# 3. BASE DE DATOS RELACIONAL (POSTGRESQL 16)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rpa_studio
DB_USERNAME=rpa_user
DB_PASSWORD=secret_password

POSTGRES_DB=rpa_studio
POSTGRES_USER=rpa_user
POSTGRES_PASSWORD=secret_password

# ==============================================================================
# 4. CACHÉ, SESIONES, COLAS Y STREAMS (REDIS 7)
# ==============================================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

REDIS_CLIENT=predis
REDIS_HOST=rpa-redis
REDIS_PORT=6379
REDIS_PASSWORD=secret_password

COMMAND_STREAM=rpa:cmd
EVENT_STREAM=rpa:evt

# ==============================================================================
# 5. WEBSOCKETS EN TIEMPO REAL (LARAVEL REVERB)
# ==============================================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rpa-studio
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ==============================================================================
# 6. AUTENTICACIÓN SANCTUM Y CORS
# ==============================================================================
FRONTEND_URL=http://localhost:3090
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=localhost:3090,127.0.0.1:3090,localhost:8000,127.0.0.1:8000,localhost,127.0.0.1

# ==============================================================================
# 7. ALMACENAMIENTO DE OBJETOS COMPATIBLE CON S3 (RUSTFS)
# ==============================================================================
RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_VOLUMES=/data

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rpa-artifacts
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=sail
S3_SECRET_KEY=password
S3_BUCKET=rpa-artifacts
S3_PUBLIC_URL=http://localhost:9000/rpa-artifacts

# ==============================================================================
# 8. INTELIGENCIA ARTIFICIAL Y MODELOS (LLM)
# ==============================================================================
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
RPA_LLM_FAST_MODEL=gemini-2.5-flash
RPA_LLM_STRONG_MODEL=gemini-2.5-pro

# ==============================================================================
# 9. FRONTEND NEXT.JS (apps/web)
# ==============================================================================
WEB_PORT=3090
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_S3_URL=http://localhost:9000/rpa-artifacts

# ==============================================================================
# 10. SITIO EN VIVO Y RUNNER (apps/runner)
# ==============================================================================
RUNNER_HEADLESS=true
RUNNER_LIVE_PORT=8085
RUNNER_LIVE_URL=http://host.docker.internal:8085
RUNNER_LIVE_TOKEN=local-live-token
NEXT_PUBLIC_LIVE_PORT=8085
# Alias opcionales de host para llamadas HTTP del Runner en dev (ej. contenedor=localhost:puerto)
RPA_HTTP_HOST_ALIASES=

# ==============================================================================
# 11. API INTERNA RUNNER ⇄ LARAVEL
# ==============================================================================
RPA_INTERNAL_SECRET=dev-internal-secret-change-me
RPA_INTERNAL_SIGNATURE_TTL=60
RPA_INTERNAL_URL=http://127.0.0.1:8000
RPA_SECRET_ACTIVE_KEY=app
RPA_SECRET_KEYS={}
