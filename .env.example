# ==============================================================================
# RPA Studio - Plantilla de Configuración de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a .env y ajusta los valores para tu entorno local o servidor.
# cp .env.example .env

# ==============================================================================
# 1. DOCKER & LARAVEL SAIL
# ==============================================================================
WWWUSER=1000
WWWGROUP=1000
LARAVEL_SAIL=1
SUPERVISOR_PHP_USER=sail

APP_PORT=8000
REVERB_SERVER_PORT=8080
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_STORAGE_PORT=9000
FORWARD_STORAGE_CONSOLE_PORT=9001

# ==============================================================================
# 2. APLICACIÓN LARAVEL (apps/api)
# ==============================================================================
APP_NAME="RPA Studio"
APP_ENV=local
APP_KEY=base64:kqx2C0B3a2aRRew2cQ2wNc7TM2urcXEtkVdNBdQEU8w=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# 3. BASE DE DATOS RELACIONAL (POSTGRESQL 16)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=rpa_studio
DB_USERNAME=rpa_user
DB_PASSWORD=secret_password

POSTGRES_DB=rpa_studio
POSTGRES_USER=rpa_user
POSTGRES_PASSWORD=secret_password

# ==============================================================================
# 4. CACHÉ, SESIONES, COLAS Y STREAMS (REDIS 7)
# ==============================================================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret_password

COMMAND_STREAM=rpa:cmd
EVENT_STREAM=rpa:evt

# ==============================================================================
# 5. WEBSOCKETS EN TIEMPO REAL (LARAVEL REVERB)
# ==============================================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rpa-studio
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ==============================================================================
# 6. AUTENTICACIÓN SANCTUM Y CORS
# ==============================================================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000,localhost,127.0.0.1

# ==============================================================================
# 7. ALMACENAMIENTO DE OBJETOS COMPATIBLE CON S3 (RUSTFS)
# ==============================================================================
RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_VOLUMES=/data

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=rpa-artifacts
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=sail
S3_SECRET_KEY=password
S3_BUCKET=rpa-artifacts

# ==============================================================================
# 8. INTELIGENCIA ARTIFICIAL Y MODELOS (LLM)
# ==============================================================================
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
RPA_LLM_FAST_MODEL=gemini-2.5-flash
RPA_LLM_STRONG_MODEL=gemini-2.5-pro

# ==============================================================================
# 9. FRONTEND NEXT.JS (apps/web)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# ==============================================================================
# 10. SITIO EN VIVO (proxy embebido + Chromium externo, apps/runner)
# ==============================================================================
# Puerto del servidor live del Runner (proxy por subdominio <sid>.localhost y API de control)
RUNNER_LIVE_PORT=8085
# URL con la que Laravel (dentro de Docker) alcanza al Runner en el host
RUNNER_LIVE_URL=http://host.docker.internal:8085
# Token compartido Laravel -> Runner para la API de control
RUNNER_LIVE_TOKEN=local-live-token
# URL pública del proxy embebido para el navegador (subdominios *.localhost)
NEXT_PUBLIC_LIVE_PORT=8085
